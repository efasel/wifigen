#!/usr/bin/env bash
#
# wifigen - Show which Wi-Fi generation the current connection uses
# Usage: wifigen [-h|--help] [interface]
#
# See README.md or https://github.com/efasel/wifigen  |  MIT License
#

set -o pipefail

die() { echo "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: wifigen [-h|--help] [-s|--scan] [interface]

Show which Wi-Fi generation the current connection uses, decoded from iw.

  interface   Wireless interface (default: first one listed by `iw dev`)
  -s, --scan  Force a fresh scan for access points (~8 s)
  -h, --help  Show this help

Details: https://github.com/efasel/wifigen
EOF
}

force_scan=false
iface=""
for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        -s|--scan) force_scan=true ;;
        -*)        usage >&2; exit 1 ;;
        *)         iface="$arg" ;;
    esac
done

command -v iw >/dev/null || die "iw not found"

iface="${iface:-$(iw dev | awk '/Interface/ {print $2; exit}')}"
[ -n "$iface" ] || die "No wireless interface found"

link="$(iw dev "$iface" link 2>&1)" || die "iw failed: $link"
grep -q "^Not connected" <<< "$link" && die "Not connected"

field() { awk -v k="$1" '$1 == k":" {print $2; exit}' <<< "$link"; }

bssid=$(awk '/^Connected to/ {print tolower($3); exit}' <<< "$link")
ssid=$(awk '$1 == "SSID:" {print substr($0, index($0, ":") + 2); exit}' <<< "$link")
freq=$(field freq)
signal=$(field signal)
rx_line=$(grep "rx bitrate:" <<< "$link")
tx_line=$(grep "tx bitrate:" <<< "$link")

# Shared awk helper: band name from frequency in MHz
BAND_AWK='function band(f) {
    if (f == "")  return "unknown"
    if (f < 2500) return "2.4 GHz"
    if (f < 5925) return "5 GHz"
    return "6 GHz"
}'

band_of() { awk -v f="$1" "$BAND_AWK"' BEGIN { print band(f) }'; }

band=$(band_of "$freq")

# Wi-Fi generation from a bitrate line: 7, 6, 5, 4, or 0 (legacy/unknown)
generation_of() {
    case "$1" in
        *EHT-MCS*) echo 7 ;;
        *HE-MCS*)  echo 6 ;;
        *VHT-MCS*) echo 5 ;;
        *" MCS "*) echo 4 ;;
        *)         echo 0 ;;
    esac
}

generation_name() {
    case "$1" in
        7) echo "Wi-Fi 7 (802.11be)" ;;
        6) if [ "$band" = "6 GHz" ]; then echo "Wi-Fi 6E (802.11ax, 6 GHz)"
           else echo "Wi-Fi 6 (802.11ax)"; fi ;;
        5) echo "Wi-Fi 5 (802.11ac)" ;;
        4) echo "Wi-Fi 4 (802.11n)" ;;
        *) echo "Legacy (802.11a/b/g)" ;;
    esac
}

phy_prefix() {
    case "$1" in
        7) echo "EHT-" ;;
        6) echo "HE-" ;;
        5) echo "VHT-" ;;
        *) echo "" ;;
    esac
}

rate_of()  { grep -oE '[0-9]+(\.[0-9]+)? MBit/s' <<< "$1" | head -1; }

# iw omits the width for 20 MHz
width_of() {
    local w
    w=$(grep -oE '[0-9]+(\+[0-9]+)?MHz' <<< "$1" | head -1)
    echo "${w:-20MHz}"
}

mcs_of() {
    local gen=$1 line=$2
    if [ "$gen" = 4 ]; then
        grep -oE '(^|[[:space:]])MCS [0-9]+' <<< "$line" | awk '{print $2}'
    elif [ "$gen" -ge 5 ]; then
        grep -oE "$(phy_prefix "$gen")MCS [0-9]+" <<< "$line" | awk '{print $2}'
    fi
}

# HT encodes the stream count in the MCS index (8 MCS per stream)
nss_of() {
    local gen=$1 line=$2 mcs
    if [ "$gen" = 4 ]; then
        mcs=$(mcs_of 4 "$line")
        [ -n "$mcs" ] && echo $(( mcs / 8 + 1 ))
    elif [ "$gen" -ge 5 ]; then
        grep -oE "$(phy_prefix "$gen")NSS [0-9]+" <<< "$line" | awk '{print $2}'
    fi
}

# >= -55 dBm Excellent, >= -67 Good, >= -75 Fair, else Weak
signal_quality() {
    local s=$1
    [[ "$s" =~ ^-?[0-9]+$ ]] || { echo "Unknown"; return; }
    if   [ "$s" -ge -55 ]; then echo "Excellent"
    elif [ "$s" -ge -67 ]; then echo "Good"
    elif [ "$s" -ge -75 ]; then echo "Fair"
    else                        echo "Weak"
    fi
}

rx_gen=$(generation_of "$rx_line")
tx_gen=$(generation_of "$tx_line")

echo "=== Link ($iface) ==="
grep -E "Connected|SSID|freq|signal|bitrate" <<< "$link"
echo

echo "=== Decoded Connection ==="
if [ "$rx_gen" = "$tx_gen" ]; then
    printf '%-15s: %s\n' "Wi-Fi Version" "$(generation_name "$rx_gen")"
else
    printf '%-15s: RX %s / TX %s\n' "Wi-Fi Version" \
        "$(generation_name "$rx_gen")" "$(generation_name "$tx_gen")"
fi
printf '%-15s: %s\n' "Band" "$band${freq:+ (${freq%.*} MHz)}"
printf '%-15s: %s\n' "Signal" "${signal:-unknown}${signal:+ dBm}"
printf '%-15s: %s\n' "Signal Quality" "$(signal_quality "$signal")"
echo
printf '%-15s  %-16s %s\n' ""              "RX"                          "TX"
printf '%-15s: %-16s %s\n' "PHY Rate"      "$(rate_of "$rx_line")"       "$(rate_of "$tx_line")"
printf '%-15s: %-16s %s\n' "Channel Width" "$(width_of "$rx_line")"      "$(width_of "$tx_line")"
printf '%-15s: %-16s %s\n' "Streams (NSS)" "$(nss_of "$rx_gen" "$rx_line")" "$(nss_of "$tx_gen" "$tx_line")"
printf '%-15s: %-16s %s\n' "MCS"           "$(mcs_of "$rx_gen" "$rx_line")" "$(mcs_of "$tx_gen" "$tx_line")"
echo

# One tab-separated record per BSS in the kernel scan cache:
# bssid, freq (MHz), signal (dBm), ssid, offered Wi-Fi generations, last seen (ms)
scan_records() {
    iw dev "$iface" scan dump 2>/dev/null | awk '
        function flush(   gens) {
            if (bssid == "") return
            if (ht)  gens = gens ", Wi-Fi 4"
            if (vht) gens = gens ", Wi-Fi 5"
            if (he)  gens = gens (freq >= 5925 ? ", Wi-Fi 6E" : ", Wi-Fi 6")
            if (eht) gens = gens ", Wi-Fi 7"
            printf "%s\t%d\t%d\t%s\t%s\t%d\n", bssid, freq, sig, ssid, substr(gens, 3), seen
        }
        /^BSS / {
            flush()
            bssid = tolower(substr($2, 1, 17))
            freq = sig = ht = vht = he = eht = seen = 0
            ssid = ""
            next
        }
        /^\tfreq:/            { freq = $2 }
        /^\tsignal:/          { sig = $2 }
        /^\tlast seen:/       { seen = $3 }
        /^\tSSID:/            { ssid = substr($0, index($0, ":") + 2) }
        /^\tHT capabilities/  { ht = 1 }
        /^\tVHT capabilities/ { vht = 1 }
        /^\tHE capabilities/  { he = 1 }
        /^\tEHT capabilities/ { eht = 1 }
        END { flush() }
    '
}

# Prefer NetworkManager (no root via polkit), fall back to sudo iw
rescan() {
    if command -v nmcli >/dev/null; then
        echo "Scanning for access points via NetworkManager (~8 s)..." >&2
        nmcli -f BSSID dev wifi list ifname "$iface" --rescan yes \
            >/dev/null 2>&1 && return
    fi
    echo "Scanning for access points via sudo iw..." >&2
    sudo iw dev "$iface" scan >/dev/null 2>&1
}

# Cache entries expire one by one ~30 s after last seen (except the
# associated BSS), and background scans may be partial. Treat the cache as
# fresh only if it holds another radio with our SSID and none of those
# radios is close to expiry.
MAX_CACHE_AGE_MS=20000
cache_is_fresh() {
    awk -F'\t' -v me="$bssid" -v ssid="$ssid" -v max="$MAX_CACHE_AGE_MS" '
        $1 != me && $4 == ssid { peers++; if ($6 > max) stale = 1 }
        END { exit !(peers && !stale) }
    ' <<< "$records"
}

# Records of radios with our SSID; $1 = "same" (our AP) or "other" (repeaters).
# Radios of one AP share BSSID octets 2-5; vendors vary the first or last octet.
same_ssid_records() {
    awk -F'\t' -v ssid="$ssid" -v fam="${bssid:3:11}" -v want="$1" '
        $4 == ssid && ((substr($1, 4, 11) == fam) == (want == "same"))
    ' <<< "$records" | sort -t$'\t' -k1.4,1.14 -k2,2n
}

# Table from records on stdin; $1 = 1 to include the BSSID column.
# Records are sorted by device, so a blank line separates devices.
print_bss_table() {
    awk -F'\t' -v me="$bssid" -v show_bssid="$1" "$BAND_AWK"'
        NR == 1 {
            if (show_bssid) printf "%-18s ", "BSSID"
            printf "%-8s %-9s %-8s %s\n", "Band", "Freq", "Signal", "Offers"
        }
        {
            device = substr($1, 4, 11)
            if (NR > 1 && device != prev) print ""
            prev = device
            if (show_bssid) printf "%-18s ", $1
            printf "%-8s %-9s %-8s %s%s\n", band($2), $2 " MHz", $3 " dBm",
                ($5 == "" ? "Legacy only" : $5), ($1 == me ? "  <- connected" : "")
        }
    '
}

[ -n "$bssid" ] || exit 0

records=$(scan_records)
if $force_scan || ! cache_is_fresh; then
    rescan
    records=$(scan_records)
fi

echo "=== Access Point Capabilities ==="
ap=$(same_ssid_records same)
if [ -n "$ap" ]; then
    print_bss_table 0 <<< "$ap"
    if awk -F'\t' '$2 < 2500 && $5 ~ /Wi-Fi 5/ { f = 1 } END { exit !f }' <<< "$ap"; then
        echo "Note: Wi-Fi 5 on 2.4 GHz is a vendor extension (256-QAM), not 802.11ac."
    fi
else
    echo "Unknown (AP not found in scan)"
fi

[ -n "$ssid" ] || exit 0

echo
echo "=== Other APs named \"$ssid\" (mesh repeaters?) ==="
others=$(same_ssid_records other)
if [ -n "$others" ]; then
    print_bss_table 1 <<< "$others"
else
    echo "None found"
fi
